[Unit]
Description=wpa_supplicant
After=multi-user.target wificond-someip-service.service

[Service]
User=root
Group=root
Type=simple
ExecStart=/usr/sbin/wpa_supplicant -dd
ExecStop=/bin/kill -INT $MAINPID
Restart=on-abort

[Install]
WantedBy=multi-user.target