package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "external_wpa_supplicant_8_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-BSD
    default_applicable_licenses: ["external_wpa_supplicant_8_license"],
}

cc_library_headers {
    name: "libwpa_aidl_headers",
    export_include_dirs: ["."],
    soc_specific: true,
}

soong_config_module_type {
    name: "wpa_cc_library_static_aidl_vendor_type",
    module_type: "cc_library_static",
    config_namespace: "wpa_supplicant_8",
    bool_variables: [
        "enable_vendor_aidl",
    ],
    properties: [
        "srcs",
    ],
}

wpa_cc_library_static_aidl_vendor_type {
     name: "libwpa_aidl_bp",
     soc_specific: true,
     srcs: [
        "aidl.cpp",
        "aidl_manager.cpp",
        "certificate_utils.cpp",
        "iface_config_utils.cpp",
        "p2p_iface.cpp",
        "p2p_network.cpp",
        "shared_utils.cpp",
        "sta_iface.cpp",
        "sta_network.cpp",
        "supplicant.cpp",
        "supplicant_wifi_rtt_controller.cpp",
        "sta_iface.cpp",
        "sta_network.cpp",
        "supplicant.cpp",
    ],
    defaults: [
        "libwpa_aidl_cflags_defaults",
        "wpa_supplicant_cflags_defaults",
    ],
    shared_libs: [
        "android.hardware.wifi.supplicant-V5-ndk",
        "android.system.keystore2-V1-ndk",
        "libbinder_ndk",
        "libbase",
        "libcrypto",
        "libutils",
        "liblog",
        "libssl",
    ],
    // Generated by building libwpa_hidl and printing LOCAL_CPPFLAGS.
    cppflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-Wno-unused-variable",
    ],
    header_libs: [
        "wpa_supplicant_headers",
        "libwpa_aidl_headers",
        "libwpa_shared_aidl_headers_vendor",
    ],
    soong_config_variables: {
        enable_vendor_aidl: {
            srcs: [
                "supplicant_vendor.cpp",
                "vendorsta_iface.cpp",
            ],
        },
    },
}

vintf_fragment {
    name: "android.hardware.wifi.supplicant.xml",
    src: "android.hardware.wifi.supplicant.xml",
    soc_specific: true,
}

vintf_fragment {
    name: "android.hardware.wifi.supplicant.vendor.xml",
    src: "android.hardware.wifi.supplicant.vendor.xml",
    soc_specific: true,
}

soong_config_module_type {
    name: "libwpa_aidl_cflags_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "libwpa_aidl",
    value_variables: [
        "nl80211_driver",
    ],
    properties: ["cflags"],
}

libwpa_aidl_cflags_cc_defaults {
    name: "libwpa_aidl_cflags_defaults",
    soong_config_variables: {
        nl80211_driver: {
            cflags: ["-D%s"],
        },
    },
}

soong_config_module_type {
    name: "supplicant_manifest_prebuilt",
    module_type: "prebuilt_etc",
    config_namespace: "wpa_supplicant_8",
    bool_variables: [
        "enable_vendor_aidl",
    ],
    properties: [
        "src",
    ],
}

supplicant_manifest_prebuilt {
    name: "android.hardware.wifi.supplicant.xml.prebuilt",
    relative_install_path: "vintf",
    installable: false,
    src: "android.hardware.wifi.supplicant.xml",
    soong_config_variables: {
        enable_vendor_aidl: {
            src: "android.hardware.wifi.supplicant.vendor.xml",
        },
    },
}

