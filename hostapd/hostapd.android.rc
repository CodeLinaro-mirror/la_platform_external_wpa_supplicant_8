on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

service hostapd /vendor/bin/hw/hostapd -dd -g /data/vendor/wifi/hostapd/global
    interface aidl android.hardware.wifi.hostapd.IHostapd/default
    interface aidl vendor.qti.hardware.wifi.hostapd.IHostapdVendor/default
    class main
    capabilities NET_ADMIN NET_RAW
    user wifi
    group wifi net_raw net_admin system
    disabled
    oneshot
