package {
    default_applicable_licenses: [
        "external_wpa_supplicant_8_license",
        "external_wpa_supplicant_8_hostapd_license",
    ],
}

cc_library_headers {
    name: "libhostapd_aidl_headers",
    export_include_dirs: ["."],
    soc_specific: true,
}

soong_config_module_type {
    name: "hostapd_cc_library_static_aidl_type",
    module_type: "cc_library_static",
    config_namespace: "wpa_supplicant_8",
    bool_variables: [
        "enable_vendor_aidl",
    ],
    properties: [
        "srcs",
    ],
}

hostapd_cc_library_static_aidl_type {
    name: "libhostapd_aidl_bp",
    defaults: ["hostapd_cflags_defaults"],
    soc_specific: true,
    srcs: [
        "aidl.cpp",
        "hostapd.cpp",
    ],
    shared_libs: [
        "android.hardware.wifi.hostapd-V3-ndk",
        "libbinder_ndk",
        "libbase",
        "libutils",
        "liblog",
    ],
    cppflags: [
        "-Wall",
        "-Werror",
    ],
    header_libs: [
        "hostapd_headers",
        "libhostapd_aidl_headers",
    ],
    soong_config_variables: {
        enable_vendor_aidl: {
            srcs: [
                "hostapd_vendor.cpp",
            ],
        },
    },
}
