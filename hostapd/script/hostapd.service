[Unit]
Description=hostapd
After=multi-user.target wpa_supplicant.service

[Service]
User=root
Group=root
Type=simple
ExecStart=/usr/sbin/hostapd -dd
ExecStop=/bin/kill -INT $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target